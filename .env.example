ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Required only when submitting jobs with server_url=openrouter
OPENROUTER_API_KEY=

# Job Server (optional)
# API_KEY=
# JOB_STORE_PATH=jobs.db
# S3-compatible storage API endpoint (defaults to the in-cluster RustFS service)
# STORAGE_ENDPOINT_URL=http://harbor-storage:9000

# Intake poller (optional)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_SHEET_ID=
# JOB_QUEUE_URL=https://job-queue.example.com
# AUTO_APPROVE=false
# ENVIRONMENT=stage
# For local-only testing with an HTTP queue, set this explicitly:
# ALLOW_INSECURE_QUEUE_HTTP=true

# GitHub datasets download directly in the job pod. Supply an optional token
# per submission using X-GitHub-Token; it is held in queue memory, never in env
# configuration, SQLite, pod specs, or files. Public repositories need no token.

# Nebius (optional)
NEBIUS_ENABLED=0
# NEBIUS_SERVICE_ACCOUNT_CREDS_PATH=
# NEBIUS_USER=
# NEBIUS_SSH_PUBLIC_KEY_PATH=
# NEBIUS_SSH_PRIVATE_KEY_PATH=
# NEBIUS_PARENT_ID=
# NEBIUS_TENANT_ID=
# NEBIUS_SERVICE_ACCOUNT_ID=
# NEBIUS_SUBNET_ID=
# NEBIUS_INSTANCE_NAME_PREFIX=job-queue-worker
# NEBIUS_IDLE_TIMEOUT_SECONDS=600
# HF_TOKEN=

# Nebius preemption handling (optional; job pausing/auto-resume only applies to nebius jobs)

# Mid-run preemptions tolerated before the job is failed instead of resumed:
# MAX_PREEMPT_RESUMES=3
# Seconds an instance must stay RUNNING after restart to be considered stable:
# PREEMPT_STABLE_SECONDS=90
# Restart attempts per recovery pass (waiting itself is unlimited):
# PREEMPT_RESTART_ATTEMPTS=10
# Seconds of continuous Nebius state-check failures tolerated while stabilizing a restart:
# PREEMPT_STABILIZE_ERROR_SECONDS=120
# How often the paused-job recovery loop runs, in seconds:
# PAUSED_POLL_INTERVAL_SECONDS=60
# Budget per wait for the job pod to finish its object-storage checkpoint upload.
# An incomplete upload retains the parent and pausing state for later checks:
# PAUSE_UPLOAD_TIMEOUT_SECONDS=600
# Sustained Nebius API outage seconds that also triggers a pause:
# NEBIUS_UNREACHABLE_TRIGGER_SECONDS=300
# Consecutive seconds of STOPPED/STOPPING/DELETED/ERROR/CRASHED observations
# (polled every ~15s) before a running job is treated as preempted:
# NEBIUS_STOPPED_TRIGGER_SECONDS=45
